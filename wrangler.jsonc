{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inventario",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // Los archivos de public/ se sirven directo; solo /api/* ejecuta el Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Un único Durable Object reparte los avisos en tiempo real a las páginas abiertas.
  "durable_objects": {
    "bindings": [{ "name": "DIFUSOR", "class_name": "Difusor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Difusor"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lector-inventario",
      "database_id": "c2e224ab-02bb-4981-bf4d-7817b84d0faf",
      "migrations_dir": "migrations"
    }
  ],
  // Modelos que puede usar el asistente (src/modelos-asistente.js). POST /api/asistente elige uno con "modelo": <id>;
  // sin él se usa el primero. proveedor es "deepseek" o "gemini"; sus parámetros fijos viven en el código.
  // CLASIFICADOR_ASISTENTE es el modelo del clasificador (src/clasificador.js), que juzga qué productos son de un grupo
  // para la herramienta productos_del_grupo. Es aparte del conversador; por ahora solo acepta "deepseek".
  "vars": {
    "MODELOS_ASISTENTE": [
      { "id": "deepseek", "proveedor": "deepseek", "modelo": "deepseek-flash" },
      { "id": "gemini", "proveedor": "gemini", "modelo": "gemini-3.6-flash" }
    ],
    "CLASIFICADOR_ASISTENTE": { "proveedor": "deepseek", "modelo": "deepseek-flash" }
  }
  // Secretos (no van en este archivo): PIMIENTA, CODIGO_CONFIGURACION, DEEPSEEK_API_KEY y GEMINI_API_KEY.
  // Sin la clave de un proveedor la app funciona igual, pero el asistente responde 503 (asistente-sin-configurar)
  // a las preguntas para sus modelos. En local se leen de .dev.vars; en Cloudflare se guardan como secretos del Worker.
}
